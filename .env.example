# Copy this file to .env.local and fill in your own Supabase project's
# values (Project Settings -> API in the Supabase dashboard).
#
# Both of these are safe to expose in the browser -- the anon key only ever
# grants what RLS policies allow for the current signed-in user. Never put
# the service role key or the database password in a NEXT_PUBLIC_ variable
# or commit them anywhere.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
